<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.ScrollPane?>

<?import javafx.scene.control.ComboBox?>
<StackPane fx:id="rootLayout"
           styleClass="root"
           stylesheets="@../../css/profile/profile-setup-view.css"
           xmlns="http://javafx.com/javafx/22"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fittrack.controller.profile.ProfileSetupController">

    <!-- If the window is too small, scroll will be added -->
    <ScrollPane fx:id="setupScroll"
                fitToWidth="true"
                hbarPolicy="NEVER"
                styleClass="setup-scroll">

        <StackPane fx:id="setupScrollContent"
                   styleClass="setup-scroll-content">

            <StackPane styleClass="setup-surface">

                <!-- Personal info-->
                <VBox fx:id="personalInfoStep"
                      alignment="CENTER_LEFT"
                      maxHeight="-Infinity"
                      styleClass="setup-form">

                    <!-- Step -->
                    <Label text="Step 1 of 2"
                           minHeight="-Infinity"
                           maxHeight="Infinity"
                           styleClass="step-label"/>

                    <!-- Title -->
                    <Label text="Personal information"
                           styleClass="setup-title"
                           wrapText="true"
                           minHeight="-Infinity"
                           maxHeight="Infinity"
                           maxWidth="Infinity"/>

                    <!-- Subtitle -->
                    <Label text="Fill in your details to set up your profile."
                           styleClass="setup-subtitle"
                           wrapText="true"
                           minHeight="-Infinity"
                           maxHeight="Infinity"
                           maxWidth="Infinity"/>

                    <!-- First name -->
                    <Label styleClass="field-label"
                           text="First name"/>

                    <TextField fx:id="firstNameField"
                               maxWidth="Infinity"
                               promptText="Enter your first name"
                               styleClass="input-field,text-field"/>

                    <Label fx:id="firstNameMessage"
                           styleClass="helper-label"
                           wrapText="true"
                           minHeight="-Infinity"
                           maxHeight="Infinity"
                           maxWidth="Infinity"/>

                    <!-- Last name -->
                    <Label styleClass="field-label"
                           text="Last name"/>

                    <TextField fx:id="lastNameField"
                               maxWidth="Infinity"
                               promptText="Enter your last name"
                               styleClass="input-field,text-field"/>

                    <Label fx:id="lastNameMessage"
                           styleClass="helper-label"
                           wrapText="true"
                           minHeight="-Infinity"
                           maxHeight="Infinity"
                           maxWidth="Infinity"/>

                    <!-- Date of birth -->
                    <Label styleClass="field-label"
                           text="Date of birth"/>

                    <DatePicker fx:id="dateOfBirthPicker"
                                maxWidth="Infinity"
                                promptText="Select your date of birth"
                                styleClass="input-field,date-picker-field"/>

                    <Label fx:id="dateOfBirthMessage"
                           styleClass="helper-label"
                           wrapText="true"
                           minHeight="-Infinity"
                           maxHeight="Infinity"
                           maxWidth="Infinity"/>

                    <!-- Gender -->
                    <Label styleClass="field-label"
                           text="Gender"/>

                    <fx:define>
                        <ToggleGroup fx:id="genderGroup"/>
                    </fx:define>

                    <HBox spacing="10"
                          styleClass="gender-options">

                        <ToggleButton fx:id="maleButton"
                                      text="Male"
                                      toggleGroup="$genderGroup"
                                      styleClass="gender-option"
                                      selected="true"/>

                        <ToggleButton fx:id="femaleButton"
                                      text="Female"
                                      toggleGroup="$genderGroup"
                                      styleClass="gender-option"/>

                    </HBox>

                    <GridPane maxWidth="Infinity"
                              styleClass="next-step-row">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <Button GridPane.columnIndex="0"
                                maxWidth="Infinity"
                                onAction="#handleNext"
                                styleClass="action-btn"
                                text="Next step"/>

                    </GridPane>

                </VBox>

                <!-- Fitness goals-->
                <VBox fx:id="fitnessGoalsStep"
                      alignment="CENTER_LEFT"
                      maxHeight="-Infinity"
                      styleClass="setup-form"
                      visible="false"
                      managed="false">

                    <GridPane maxWidth="Infinity">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="70"/>
                        </columnConstraints>

                        <Button fx:id="backButton"
                                GridPane.columnIndex="0"
                                maxWidth="Infinity"
                                onAction="#handleBack"
                                styleClass="back-btn"
                                text="← Back"/>

                    </GridPane>

                    <!-- Step -->
                    <Label text="Step 2 of 2"
                           styleClass="step-label"/>

                    <!-- Title -->
                    <Label text="Fitness goals"
                           styleClass="setup-title"
                           wrapText="true"
                           maxWidth="Infinity"/>

                    <!-- Subtitle -->
                    <Label text="Set your starting measurements and define your target."
                           styleClass="setup-subtitle"
                           wrapText="true"
                           maxWidth="Infinity"/>

                    <!-- Height -->
                    <Label styleClass="field-label"
                           text="Height (cm)"/>

                    <TextField fx:id="heightField"
                               maxWidth="Infinity"
                               promptText="Enter your height"
                               styleClass="input-field,text-field"/>

                    <Label fx:id="heightMessage"
                           styleClass="helper-label"
                           wrapText="true"
                           minHeight="-Infinity"
                           maxHeight="Infinity"
                           maxWidth="Infinity"/>

                    <!-- Weight -->
                    <Label styleClass="field-label"
                           text="Weight (kg)"/>

                    <TextField fx:id="weightField"
                               maxWidth="Infinity"
                               promptText="Enter your weight"
                               styleClass="input-field,text-field"/>

                    <Label fx:id="weightMessage"
                           styleClass="helper-label"
                           wrapText="true"
                           minHeight="-Infinity"
                           maxHeight="Infinity"
                           maxWidth="Infinity"/>

                    <!-- Activity level -->
                    <Label styleClass="field-label"
                           text="Activity"/>

                    <ComboBox fx:id="activityLevelComboBox"
                              maxWidth="Infinity"
                              promptText="Choose your activity level"
                              styleClass="input-field, combo-box-field"/>

                    <Label fx:id="activityLevelMessage"
                           styleClass="helper-label"
                           wrapText="true"
                           minHeight="-Infinity"
                           maxHeight="Infinity"
                           maxWidth="Infinity"/>

                    <!-- Goal type -->
                    <Label styleClass="field-label"
                           text="Goal"/>

                    <ComboBox fx:id="goalTypeComboBox"
                               maxWidth="Infinity"
                               promptText="Choose your weight goal"
                               styleClass="input-field, combo-box-field"/>

                    <Label fx:id="goalTypeMessage"
                           styleClass="helper-label"
                           wrapText="true"
                           minHeight="-Infinity"
                           maxHeight="Infinity"
                           maxWidth="Infinity"/>


                    <!-- Goal weight and Weekly goal -->
                    <VBox fx:id="goalWeightBox"
                          styleClass="goal-weight-box"
                          visible="false"
                          managed="false">

                        <Label styleClass="field-label"
                               text="Goal weight (kg)"/>

                        <TextField fx:id="goalWeightField"
                                   maxWidth="Infinity"
                                   promptText="Enter your goal weight"
                                   styleClass="input-field, text-field"/>

                        <Label fx:id="goalWeightMessage"
                               styleClass="helper-label"
                               wrapText="true"
                               minHeight="-Infinity"
                               maxHeight="Infinity"
                               maxWidth="Infinity"/>

                        <Label styleClass="field-label"
                               text="Weekly goal (kg)"/>

                        <ComboBox fx:id="weeklyGoalComboBox"
                                   maxWidth="Infinity"
                                   promptText="Choose your weekly goal"
                                   styleClass="input-field, combo-box-field"/>

                        <Label fx:id="weeklyGoalMessage"
                               styleClass="helper-label"
                               wrapText="true"
                               minHeight="-Infinity"
                               maxHeight="Infinity"
                               maxWidth="Infinity"/>

                    </VBox>

                    <GridPane maxWidth="Infinity"
                              styleClass="next-step-row">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <Button fx:id="finishButton"
                                maxWidth="Infinity"
                                onAction="#handleFinish"
                                styleClass="action-btn"
                                text="Finish"/>

                    </GridPane>

                </VBox>

            </StackPane>

        </StackPane>

    </ScrollPane>

</StackPane>