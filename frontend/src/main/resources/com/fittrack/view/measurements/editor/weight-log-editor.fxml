<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootLayout"
           xmlns="http://javafx.com/javafx/22"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fittrack.controller.measurements.editor.WeightLogEditorController"
           stylesheets="@../../../css/measurements/editor/weight-log-editor.css"
           styleClass="weight-log-editor-view">

    <VBox maxWidth="Infinity"
          maxHeight="-Infinity"
          StackPane.alignment="TOP_CENTER"
          styleClass="weight-log-editor-root">

        <VBox maxWidth="Infinity"
              styleClass="weight-log-editor-content">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT"
                  styleClass="weight-log-editor-header">

                <VBox spacing="0.2">

                    <Label text="Weight"
                           styleClass="weight-log-editor-caption"/>

                    <Label fx:id="titleLabel"
                           text="Add weight"
                           styleClass="weight-log-editor-title"/>

                </VBox>

            </HBox>

            <!-- Weight -->
            <VBox maxWidth="Infinity"
                  styleClass="field-group">

                <Label text="Weight (kg)"
                       styleClass="field-label"/>

                <TextField fx:id="weightField"
                           maxWidth="Infinity"
                           promptText="e.g. 78.5"
                           styleClass="input-field, text-field"/>

                <Label fx:id="weightMessage"
                       styleClass="helper-label"
                       wrapText="true"
                       minHeight="-Infinity"
                       maxHeight="Infinity"
                       maxWidth="Infinity"/>

            </VBox>

            <!-- Date -->
            <VBox maxWidth="Infinity"
                  styleClass="field-group">

                <Label text="Date"
                       styleClass="field-label"/>

                <DatePicker fx:id="datePicker"
                            maxWidth="Infinity" styleClass="input-field, date-picker-field"/>

                <Label fx:id="dateMessage"
                       styleClass="helper-label"
                       wrapText="true"
                       minHeight="-Infinity"
                       maxHeight="Infinity"
                       maxWidth="Infinity"/>

            </VBox>

            <!-- Action Error -->
            <Label fx:id="actionMessage"
                   visible="false"
                   managed="false"
                   wrapText="true"
                   maxWidth="Infinity"
                   styleClass="error-label"/>

            <!-- Actions -->
            <GridPane styleClass="weight-log-editor-actions">

                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <Button text="Cancel"
                        maxWidth="Infinity"
                        onAction="#handleCancel"
                        styleClass="back-btn, weight-log-editor-action-button"
                        GridPane.columnIndex="0"/>

                <Button fx:id="saveButton"
                        text="Add weight"
                        maxWidth="Infinity"
                        onAction="#handleSave"
                        styleClass="action-btn, weight-log-editor-action-button"
                        GridPane.columnIndex="1"/>

            </GridPane>

        </VBox>

    </VBox>

</StackPane>