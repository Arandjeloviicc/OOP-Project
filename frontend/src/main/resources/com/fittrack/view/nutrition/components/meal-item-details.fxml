<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.Region?>

<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<VBox xmlns="http://javafx.com/javafx/22"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fittrack.controller.nutrition.components.MealItemDetailsController"
      stylesheets="@../../../css/nutrition/components/meal-item-details.css"
      styleClass="meal-item-details">

    <!-- Header -->
    <HBox alignment="TOP_CENTER"
          styleClass="meal-item-details-header">

        <VBox styleClass="meal-item-details-title-group">
            <Label fx:id="captionLabel"
                   styleClass="meal-item-details-caption"/>

            <Label fx:id="selectedFoodTitleLabel"
                   text="Food name"
                   styleClass="meal-item-details-title"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

    </HBox>

    <!-- Meal -->
    <VBox styleClass="field-group">
        <Label text="Meal"
               styleClass="field-label"/>

        <ComboBox fx:id="mealComboBox"
                  maxWidth="Infinity"
                  styleClass="input-field, combo-box-field"/>
    </VBox>

    <!-- Servings -->
    <HBox fx:id="servingRow"
          styleClass="meal-item-details-serving-row">

        <!-- Serving size -->
        <VBox fx:id="servingSizeContainer"
              styleClass="field-group">

            <Label text="Serving size"
                   styleClass="field-label"/>

            <ComboBox fx:id="servingSizeComboBox"
                      maxWidth="Infinity"
                      styleClass="input-field, combo-box-field"/>
        </VBox>

        <!-- Number of servings -->
        <VBox fx:id="servingsContainer"
              styleClass="field-group">

            <Label text="Number of servings"
                   styleClass="field-label"/>

            <TextField fx:id="servingsField"
                       promptText="Enter a number of servings"
                       maxWidth="Infinity"
                       styleClass="input-field, text-field"/>

            <Label fx:id="servingsMessage"
                   styleClass="helper-label"
                   wrapText="true"
                   minHeight="-Infinity"
                   maxHeight="Infinity"
                   maxWidth="Infinity"/>
        </VBox>

    </HBox>

    <!-- Nutrition preview -->
    <VBox fx:id="nutrientPreview"
          alignment="CENTER_LEFT">

        <!-- Add Nutrition Preview Card -->

    </VBox>

    <!-- Actions -->
    <GridPane styleClass="meal-item-details-actions">

        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS"
                               minWidth="0"/>
            <ColumnConstraints hgrow="ALWAYS"
                               minWidth="0"/>
        </columnConstraints>

        <Button text="Cancel"
                maxWidth="Infinity"
                onAction="#handleCancel"
                styleClass="back-btn, meal-item-details-action-button"
                GridPane.columnIndex="0"/>

        <Button fx:id="confirmButton"
                maxWidth="Infinity"
                onAction="#handleConfirm"
                styleClass="action-btn, meal-item-details-action-button"
                GridPane.columnIndex="1"/>

    </GridPane>

</VBox>