<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<StackPane fx:id="rootLayout"
           xmlns="http://javafx.com/javafx/22"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fittrack.controller.nutrition.AddToMealController"
           stylesheets="@../../css/nutrition/add-to-meal.css"
           styleClass="popup-root">

    <!-- Selection -->
    <VBox fx:id="selectionContainer"
          styleClass="popup-host">

        <VBox fx:id="selectionDialog"
              styleClass="popup-dialog, add-to-meal-dialog">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT"
                  styleClass="add-to-meal-header">

                <Button text="←"
                        onAction="#handleBack"
                        styleClass="add-to-meal-header-button"/>

                <VBox spacing="2">
                    <Label text="Nutrition"
                           styleClass="add-to-meal-caption"/>

                    <Label fx:id="titleLabel"
                           text="Add to meal"
                           styleClass="add-to-meal-title"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="✕"
                        onAction="#handleClose"
                        styleClass="add-to-meal-header-button"/>
            </HBox>

            <!-- Search -->
            <TextField fx:id="searchField"
                       promptText="Search foods..."
                       styleClass="input-field, text-field, add-to-meal-search"/>

            <fx:define>
                <ToggleGroup fx:id="searchSourceGroup"/>
            </fx:define>

            <HBox styleClass="add-to-meal-tabs">

                <ToggleButton fx:id="allFoodsButton"
                              text="All"
                              toggleGroup="$searchSourceGroup"
                              selected="true"
                              maxWidth="Infinity"
                              HBox.hgrow="ALWAYS"
                              styleClass="add-to-meal-tab"/>

                <ToggleButton fx:id="myFoodsButton"
                              text="My Foods"
                              toggleGroup="$searchSourceGroup"
                              maxWidth="Infinity"
                              HBox.hgrow="ALWAYS"
                              styleClass="add-to-meal-tab"/>

                <ToggleButton fx:id="myMealsButton"
                              text="My Meals"
                              toggleGroup="$searchSourceGroup"
                              maxWidth="Infinity"
                              HBox.hgrow="ALWAYS"
                              styleClass="add-to-meal-tab"/>

            </HBox>

            <!-- Create -->
            <VBox fx:id="createPanel"
                  alignment="CENTER"
                  visible="false"
                  managed="false"
                  onMouseClicked="#handleCreateItem"
                  styleClass="add-to-meal-create-panel">

                <Label text="+"
                       styleClass="add-to-meal-create-icon"/>

                <Label fx:id="createPanelLabel"
                       text="Create a food"
                       styleClass="add-to-meal-create-text"/>

            </VBox>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        VBox.vgrow="ALWAYS"
                        styleClass="app-scroll">

                <VBox fx:id="resultsContainer"
                      styleClass="add-to-meal-results">

                    <Label text="Food list will be shown here."
                           styleClass="add-to-meal-placeholder"/>

                </VBox>

            </ScrollPane>

        </VBox>

    </VBox>

    <!-- Item details -->
    <StackPane fx:id="itemDetailsContainer"
               visible="false"
               managed="false"
               styleClass="popup-host"/>

    <!-- Food / Meal editor -->
    <StackPane fx:id="editorContainer"
               visible="false"
               managed="false"
               styleClass="popup-host"/>

</StackPane>