<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootLayout"
           xmlns="http://javafx.com/javafx/22"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fittrack.controller.nutrition.components.SavedMealEditorController"
           stylesheets="@../../../css/nutrition/components/saved-meal-editor.css"
           styleClass="popup-host, saved-meal-editor-root">

    <!-- Editor -->
    <VBox fx:id="editorContainer"
          styleClass="popup-dialog, saved-meal-editor-dialog">

        <!-- Header -->
        <HBox styleClass="saved-meal-editor-header">

            <VBox spacing="0.2">
                <Label text="My Meal"
                       styleClass="saved-meal-editor-caption"/>

                <Label fx:id="titleLabel"
                       text="Create Meal"
                       styleClass="saved-meal-editor-title"/>
            </VBox>

        </HBox>

        <!-- Name -->
        <VBox styleClass="field-group">

            <Label text="Name"
                   styleClass="field-label"/>

            <TextField fx:id="nameField"
                       promptText="e.g. Post Workout"
                       styleClass="input-field, text-field"/>

            <Label fx:id="nameMessage"
                   styleClass="helper-label"
                   wrapText="true"
                   minHeight="-Infinity"
                   maxHeight="Infinity"
                   maxWidth="Infinity"/>

        </VBox>

        <!-- Macro Preview -->
        <VBox fx:id="macroPreviewContainer"
              styleClass="saved-meal-editor-macro-container"/>

        <!-- Foods Header -->
        <HBox styleClass="saved-meal-editor-section-header">

            <Label text="Foods"
                   styleClass="saved-meal-editor-section-title"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <Label fx:id="itemCountLabel"
                   text="0 items"
                   styleClass="saved-meal-editor-item-count"/>

        </HBox>

        <!-- Foods -->
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    VBox.vgrow="ALWAYS"
                    styleClass="app-scroll, saved-meal-editor-scroll">

            <VBox fx:id="itemsContainer"
                  styleClass="saved-meal-editor-items"/>

        </ScrollPane>

        <!-- Add Food -->
        <Button text="+  Add food"
                maxWidth="Infinity"
                onAction="#handleAddFood"
                styleClass="action-btn, saved-meal-editor-add-button"/>

        <!-- Cancel / Create or Save -->
        <GridPane styleClass="saved-meal-editor-actions">

            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS"
                                   minWidth="0"/>

                <ColumnConstraints hgrow="ALWAYS"
                                   minWidth="0"/>
            </columnConstraints>

            <Button text="Cancel"
                    maxWidth="Infinity"
                    onAction="#handleCancel"
                    styleClass="back-btn, saved-meal-editor-action-button"
                    GridPane.columnIndex="0"/>

            <Button fx:id="saveButton"
                    text="Create meal"
                    maxWidth="Infinity"
                    visible="false"
                    onAction="#handleSave"
                    styleClass="action-btn, saved-meal-editor-action-button"
                    GridPane.columnIndex="1"/>

        </GridPane>

        <!-- Delete whole saved meal - edit mode only -->
        <Button fx:id="deleteMealButton"
                text="Delete meal"
                maxWidth="Infinity"
                visible="false"
                managed="false"
                onAction="#handleDeleteMeal"
                styleClass="saved-meal-editor-action-button, saved-meal-editor-delete-button"/>

    </VBox>

    <!-- Edit one draft MealItem -->
    <StackPane fx:id="itemDetailsContainer"
               visible="false"
               managed="false"
               styleClass="popup-host, saved-meal-editor-item-details-container"/>

    <!-- Delete confirmation -->
    <StackPane fx:id="confirmationContainer"
               visible="false"
               managed="false"
               styleClass="popup-host, saved-meal-editor-confirmation-container"/>

</StackPane>