<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ComboBox?>

<?import javafx.scene.control.ScrollPane?>
<StackPane fx:id="rootLayout"
           xmlns="http://javafx.com/javafx/22"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fittrack.controller.nutrition.AddFoodController"
           stylesheets="@../../css/nutrition/add-food-view.css"
           styleClass="add-food-root">

    <!-- Food list -->
    <VBox fx:id="foodListContainer"
          alignment="CENTER"
          styleClass="add-food-list-container">

        <VBox fx:id="dialogContainer"
              styleClass="add-food-dialog">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT"
                  styleClass="add-food-header">

                <VBox spacing="2">
                    <Label text="Nutrition"
                           styleClass="add-food-caption"/>

                    <Label fx:id="titleLabel"
                           text="Add Food"
                           styleClass="add-food-title"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="✕"
                        onAction="#handleClose"
                        styleClass="add-food-close-button"/>
            </HBox>

            <!-- Search -->
            <TextField fx:id="searchField"
                       promptText="Search foods..."
                       styleClass="input-field, text-field, add-food-search"/>

            <!-- Tabs -->
            <fx:define>
                <ToggleGroup fx:id="foodCategoryGroup"/>
            </fx:define>

            <HBox styleClass="add-food-tabs">

                <ToggleButton fx:id="allFoodsButton"
                              text="All"
                              toggleGroup="$foodCategoryGroup"
                              selected="true"
                              styleClass="add-food-tab"/>

                <ToggleButton fx:id="myFoodsButton"
                              text="My Foods"
                              toggleGroup="$foodCategoryGroup"
                              styleClass="add-food-tab"/>

                <ToggleButton fx:id="myMealsButton"
                              text="My Meals"
                              toggleGroup="$foodCategoryGroup"
                              styleClass="add-food-tab"/>

            </HBox>

            <!-- List -->
            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        VBox.vgrow="ALWAYS"
                        styleClass="app-scroll">

                <VBox fx:id="itemsContainer"
                      styleClass="add-food-items">

                    <Label text="Food list will be shown here."
                           styleClass="add-food-placeholder"/>
                </VBox>

            </ScrollPane>

        </VBox>

    </VBox>

    <!-- Add food to a meal -->
    <VBox fx:id="foodDetailsContainer"
          visible="false"
          managed="false"
          styleClass="add-food-details-container">

        <VBox styleClass="add-food-details">

            <!-- Header -->
            <HBox alignment="TOP_CENTER"
                  styleClass="add-food-details-header">

                <VBox spacing="3">
                    <Label text="Add food"
                           styleClass="add-food-details-caption"/>

                    <Label fx:id="selectedFoodTitleLabel"
                           text="Food name"
                           styleClass="add-food-details-title"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

            </HBox>

            <!-- Meal -->
            <VBox styleClass="field-group">
                <Label text="Meal"
                       styleClass="field-label"/>

                <ComboBox fx:id="mealComboBox"
                          maxWidth="Infinity"
                          styleClass="input-field, combo-box-field"/>
            </VBox>

            <!-- Servings -->
            <HBox fx:id="servingRow"
                  spacing="10">

                <!-- Serving size -->
                <VBox fx:id="servingSizeContainer"
                      styleClass="field-group">

                    <Label text="Serving size"
                           styleClass="field-label"/>

                    <ComboBox fx:id="servingSizeComboBox"
                              maxWidth="Infinity"
                              styleClass="input-field, combo-box-field"/>
                </VBox>

                <!-- Number of servings -->
                <VBox fx:id="servingsContainer"
                      styleClass="field-group">

                    <Label text="Number of servings"
                           styleClass="field-label"/>

                    <TextField fx:id="servingsField"
                               promptText="Enter a number of servings"
                               maxWidth="Infinity"
                               styleClass="input-field, text-field"/>

                    <Label fx:id="servingsMessage"
                           styleClass="helper-label"
                           wrapText="true"
                           minHeight="-Infinity"
                           maxHeight="Infinity"
                           maxWidth="Infinity"/>
                </VBox>

            </HBox>

            <!-- Nutrition preview -->
            <VBox fx:id="nutrientPreview">

            </VBox>

            <!-- Actions -->
            <HBox spacing="10"
                  styleClass="add-food-details-actions">

                <Button text="Cancel"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"
                        onAction="#handleCancelFoodDetails"
                        styleClass="back-btn, add-food-details-button"/>

                <Button text="Add to meal"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"
                        onAction="#handleConfirmAddFood"
                        styleClass="action-btn, add-food-details-button"/>

            </HBox>

        </VBox>

    </VBox>

</StackPane>