<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ScrollPane?>
<StackPane fx:id="rootLayout"
           xmlns="http://javafx.com/javafx/22"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fittrack.controller.nutrition.AddFoodController"
           stylesheets="@../../css/nutrition/add-food-view.css"
           styleClass="popup-root, add-food-root">

    <!-- Food list -->
    <VBox fx:id="foodListContainer"
          alignment="CENTER"
          styleClass="add-food-list-container">

        <VBox fx:id="dialogContainer"
              styleClass="popup-dialog, add-food-dialog">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT"
                  styleClass="add-food-header">

                <Button text="←"
                        onAction="#handleBack"
                        styleClass="add-food-close-button"/>

                <VBox spacing="2">
                    <Label text="Nutrition"
                           styleClass="add-food-caption"/>

                    <Label fx:id="titleLabel"
                           text="Add Food"
                           styleClass="add-food-title"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="✕"
                        onAction="#handleClose"
                        styleClass="add-food-close-button"/>
            </HBox>

            <!-- Search -->
            <TextField fx:id="searchField"
                       promptText="Search foods..."
                       styleClass="input-field, text-field, add-food-search"/>

            <!-- Tabs -->
            <fx:define>
                <ToggleGroup fx:id="foodCategoryGroup"/>
            </fx:define>

            <HBox styleClass="add-food-tabs">

                <ToggleButton fx:id="allFoodsButton"
                              text="All"
                              toggleGroup="$foodCategoryGroup"
                              selected="true"
                              maxWidth="Infinity"
                              HBox.hgrow="ALWAYS"
                              styleClass="add-food-tab"/>

                <ToggleButton fx:id="myFoodsButton"
                              text="My Foods"
                              toggleGroup="$foodCategoryGroup"
                              maxWidth="Infinity"
                              HBox.hgrow="ALWAYS"
                              styleClass="add-food-tab"/>

                <ToggleButton fx:id="myMealsButton"
                              text="My Meals"
                              toggleGroup="$foodCategoryGroup"
                              maxWidth="Infinity"
                              HBox.hgrow="ALWAYS"
                              styleClass="add-food-tab"/>

            </HBox>

            <!-- Create Button -->
            <VBox fx:id="createItemPanel"
                  alignment="CENTER"
                  visible="false"
                  managed="false"
                  onMouseClicked="#handleCreateItem"
                  styleClass="add-food-create-panel">

                <Label fx:id="createItemIcon"
                       text="+"
                       styleClass="add-food-create-icon"/>

                <Label fx:id="createItemLabel"
                       text="Create a food"
                       styleClass="add-food-create-text"/>

            </VBox>

            <!-- List -->
            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        VBox.vgrow="ALWAYS"
                        styleClass="app-scroll">

                <VBox fx:id="itemsContainer"
                      styleClass="add-food-items">

                    <Label text="Food list will be shown here."
                           styleClass="add-food-placeholder"/>
                </VBox>

            </ScrollPane>

        </VBox>

    </VBox>

    <!-- Add food to a meal -->
    <VBox fx:id="foodDetailsContainer"
          visible="false"
          managed="false"
          styleClass="add-food-details-container">

        <!-- Add Food Card -->

    </VBox>

    <!-- Create item -->
    <VBox fx:id="createItemContainer"
          visible="false"
          managed="false"
          styleClass="create-item-container">

        <!-- Add Food Card -->

    </VBox>

</StackPane>