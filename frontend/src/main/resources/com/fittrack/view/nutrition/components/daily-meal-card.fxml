<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fittrack.controller.nutrition.components.DailyMealCardController"
      stylesheets="@../../../css/nutrition/components/daily-meal-card.css"
      onMouseClicked="#handleOpen"
      styleClass="daily-meal-card">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT"
          styleClass="daily-meal-card-header">

        <Label fx:id="titleLabel"
               styleClass="daily-meal-card-title"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="menuButton"
                text="..."
                onAction="#handleMenu"
                styleClass="daily-meal-card-menu-button"/>

        <Button text="Log"
                onAction="#handleLog"
                styleClass="daily-meal-card-log-button"/>

    </HBox>

    <!-- Meal preview -->
    <HBox alignment="CENTER_LEFT"
          styleClass="daily-meal-card-content">

        <!-- Icon -->
        <StackPane styleClass="daily-meal-card-icon-container">

            <ImageView fx:id="mealIcon"
                       fitWidth="34"
                       fitHeight="34"
                       preserveRatio="true"/>

        </StackPane>

        <!-- Food + calories -->
        <VBox alignment="CENTER_LEFT"
              styleClass="daily-meal-card-info">

            <HBox alignment="BASELINE_LEFT"
                  styleClass="daily-meal-card-food-preview">

                <Label fx:id="firstFoodLabel"
                       styleClass="daily-meal-card-first-food"/>

                <Label fx:id="moreFoodsLabel"
                       text="and 2 more"
                       styleClass="daily-meal-card-more-foods"/>

            </HBox>

            <Label fx:id="caloriesLabel"
                   styleClass="daily-meal-card-calories"/>

        </VBox>

    </HBox>

</VBox>