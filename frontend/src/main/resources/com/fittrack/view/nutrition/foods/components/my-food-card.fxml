<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.image.ImageView?>
<?import com.fittrack.config.AppImages?>

<HBox xmlns="http://javafx.com/javafx/22"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fittrack.controller.nutrition.foods.components.MyFoodCardController"
      stylesheets="@../../../../css/nutrition/foods/components/my-food-card.css"
      alignment="CENTER_LEFT"
      onMouseClicked="#handleEdit"
      styleClass="my-food-card">

    <!-- Click to edit -->
    <HBox alignment="CENTER_LEFT"
          maxWidth="Infinity"
          HBox.hgrow="ALWAYS"
          styleClass="my-food-card-content">

        <!-- Food info -->
        <VBox alignment="CENTER_LEFT"
              HBox.hgrow="ALWAYS"
              styleClass="my-food-card-info">

            <Label fx:id="nameLabel"
                   styleClass="my-food-card-name"/>

            <Label fx:id="detailsLabel"
                   styleClass="my-food-card-details"/>

        </VBox>

        <!-- Calories -->
        <Label fx:id="caloriesLabel"
               styleClass="my-food-card-calories"/>

    </HBox>

    <!-- Delete -->
    <Button fx:id="deleteButton"
            focusTraversable="false"
            onAction="#handleDelete"
            styleClass="my-food-card-delete">
        <graphic>
            <ImageView fitWidth="16"
                       fitHeight="16"
                       preserveRatio="true">
                <AppImages fx:constant="TRASH_ICON"/>
            </ImageView>
        </graphic>
    </Button>

</HBox>