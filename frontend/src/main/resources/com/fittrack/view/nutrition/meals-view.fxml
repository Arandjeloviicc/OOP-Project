<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Label?>

<StackPane fx:id="rootLayout"
           xmlns="http://javafx.com/javafx/22"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fittrack.controller.nutrition.MealsController"
           stylesheets="@../../css/nutrition/meals-view.css"
           styleClass="meals-container">

    <fx:define>

        <!-- Summary-->
        <VBox fx:id="summaryContent"
              maxWidth="Infinity"
              styleClass="summary-container">

            <Label fx:id="summaryTitle"
                   text="Summary"
                   maxWidth="Infinity"
                   styleClass="section-title"/>

            <!-- Calories -->
            <VBox fx:id="caloriesContainer"
                  maxWidth="Infinity"/>

            <!-- Macros -->
            <VBox fx:id="wideMacrosContainer"
                  maxWidth="Infinity"
                  styleClass="macros-wide-container"/>

            <HBox fx:id="narrowMacrosContainer"
                  maxWidth="Infinity"
                  visible="false"
                  managed="false"
                  styleClass="macros-narrow-container"/>

        </VBox>

        <!-- Diary -->
        <VBox fx:id="diaryContent"
              maxWidth="Infinity"
              styleClass="diary-container">

            <Label text="Diary"
                   maxWidth="Infinity"
                   styleClass="section-title"/>

        </VBox>

    </fx:define>

    <!-- If the window is too small, scroll will be added -->
    <ScrollPane fx:id="mealsScroll"
                fitToWidth="true"
                hbarPolicy="NEVER"
                styleClass="app-scroll">

        <BorderPane fx:id="mealsContent"
                    maxWidth="Infinity"
                    styleClass="app-scroll-content, meals-content">

            <!-- Date navigation -->
            <top>
                <HBox maxWidth="Infinity"
                      alignment="CENTER"
                      styleClass="meals-date-navigation">

                    <Button text="‹"
                            onAction="#handlePreviousDay"
                            styleClass="meals-date-button"/>

                    <DatePicker fx:id="datePicker"
                                editable="false"
                                styleClass="input-field, date-picker-field, meals-date-picker"/>

                    <Button text="›"
                            onAction="#handleNextDay"
                            styleClass="meals-date-button"/>

                </HBox>
            </top>

            <!-- Summary + Diary -->
            <center>
                <StackPane styleClass="meals-body-stack">

                    <!-- WIDE -->
                    <HBox fx:id="wideContainer"
                          maxWidth="Infinity"
                          styleClass="meals-wide-container">

                    </HBox>

                    <!-- NARROW -->
                    <VBox fx:id="narrowContainer"
                          maxWidth="Infinity"
                          visible="false"
                          managed="false"
                          styleClass="meals-narrow-container">

                    </VBox>

                </StackPane>
            </center>

        </BorderPane>

    </ScrollPane>

</StackPane>