<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/22"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fittrack.controller.common.components.DeleteConfirmationController"
      stylesheets="@../../../css/common/components/delete-confirmation.css"
      maxHeight="-Infinity"
      styleClass="delete-confirmation-dialog">

    <!-- Header -->
    <VBox spacing="0.35">
        <Label fx:id="titleLabel"
               text="Delete?"
               styleClass="delete-confirmation-title"/>

        <Label fx:id="messageLabel"
               text="Are you sure you want to delete this item?"
               wrapText="true"
               maxWidth="Infinity"
               styleClass="delete-confirmation-message"/>
    </VBox>

    <!-- Actions -->
    <GridPane styleClass="delete-confirmation-actions">

        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS"
                               minWidth="0"/>

            <ColumnConstraints hgrow="ALWAYS"
                               minWidth="0"/>
        </columnConstraints>

        <Button text="Cancel"
                maxWidth="Infinity"
                onAction="#handleCancel"
                styleClass="back-btn, delete-confirmation-action-button"
                GridPane.columnIndex="0"/>

        <Button fx:id="confirmButton"
                text="Delete"
                maxWidth="Infinity"
                onAction="#handleConfirm"
                styleClass="delete-confirmation-delete-button, delete-confirmation-action-button"
                GridPane.columnIndex="1"/>

    </GridPane>

</VBox>