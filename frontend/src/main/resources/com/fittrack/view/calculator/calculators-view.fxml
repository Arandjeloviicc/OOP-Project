<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Button?>

<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.ComboBox?>

<BorderPane fx:id="rootLayout"
            xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fittrack.controller.calculator.CalculatorsController"
            stylesheets="@../../css/calculator/calculators-view.css"
            styleClass="calculators-container">

    <fx:define>
        <!-- Calculators Button Group -->
        <ToggleGroup fx:id="calculatorGroup"/>

        <!-- Gender Button Group -->
        <ToggleGroup fx:id="genderGroup"/>

        <!-- Form panel -->
        <VBox fx:id="formPanel"
              maxWidth="Infinity"
              styleClass="form-panel">

            <VBox styleClass="calculator-form-content">

                <!-- Age -->
                <VBox fx:id="ageGroup"
                      visible="false"
                      managed="false"
                      styleClass="field-group">

                    <Label styleClass="field-label"
                           text="Age"/>

                    <TextField fx:id="ageField"
                               promptText="Enter your age"
                               styleClass="input-field,text-field"/>

                    <Label fx:id="ageMessage"
                           styleClass="helper-label"
                           wrapText="true"
                           minHeight="-Infinity"
                           maxHeight="Infinity"
                           maxWidth="Infinity"/>
                </VBox>

                <!-- Gender -->
                <VBox fx:id="genderGroupContainer"
                      visible="false"
                      managed="false"
                      styleClass="field-group">

                    <Label styleClass="field-label"
                           text="Gender"/>

                    <HBox spacing="10"
                          styleClass="gender-options">

                        <ToggleButton fx:id="maleButton"
                                      text="Male"
                                      toggleGroup="$genderGroup"
                                      styleClass="gender-option"
                                      selected="true"/>

                        <ToggleButton fx:id="femaleButton"
                                      text="Female"
                                      toggleGroup="$genderGroup"
                                      styleClass="gender-option"/>
                    </HBox>
                </VBox>


                <!-- Height -->
                <VBox styleClass="field-group">
                    <Label styleClass="field-label"
                           text="Height (cm)"/>

                    <TextField fx:id="heightField"
                               promptText="Enter your height"
                               styleClass="input-field,text-field"/>

                    <Label fx:id="heightMessage"
                           styleClass="helper-label"
                           wrapText="true"
                           minHeight="-Infinity"
                           maxHeight="Infinity"
                           maxWidth="Infinity"/>
                </VBox>

                <!-- Weight -->
                <VBox styleClass="field-group">
                    <Label styleClass="field-label"
                           text="Weight (kg)"/>

                    <TextField fx:id="weightField"
                               promptText="Enter your weight"
                               styleClass="input-field,text-field"/>

                    <Label fx:id="weightMessage"
                           styleClass="helper-label"
                           wrapText="true"
                           minHeight="-Infinity"
                           maxHeight="Infinity"
                           maxWidth="Infinity"/>
                </VBox>

                <!-- Activity level -->
                <VBox fx:id="activityLevelGroup"
                      visible="false"
                      managed="false"
                      styleClass="field-group">

                    <Label styleClass="field-label"
                           text="Activity level"/>

                    <ComboBox fx:id="activityLevelComboBox"
                              maxWidth="Infinity"
                              promptText="Choose your activity level"
                              styleClass="input-field,combo-box-field"/>

                    <Label fx:id="activityLevelMessage"
                           styleClass="helper-label"
                           wrapText="true"
                           minHeight="-Infinity"
                           maxHeight="Infinity"
                           maxWidth="Infinity"/>
                </VBox>

                <!-- Optional body fat for TDEE -->
                <VBox fx:id="bodyFatSettingsGroup"
                      visible="false"
                      managed="false"
                      styleClass="field-group">

                    <Label fx:id="bodyFatToggleLabel"
                           text="+ Add body fat percentage"
                           onMouseClicked="#handleBodyFatToggle"
                           styleClass="optional-field-toggle"/>

                    <VBox fx:id="bodyFatFieldGroup"
                          visible="false"
                          managed="false"
                          styleClass="field-group">

                        <Label text="Body fat (%)"
                               styleClass="field-label"/>

                        <TextField fx:id="bodyFatField"
                                   promptText="Enter your body fat percentage"
                                   styleClass="input-field, text-field"/>

                        <Label fx:id="bodyFatMessage"
                               text="Optional. Used for a more personalized BMR estimate."
                               wrapText="true"
                               maxWidth="Infinity"
                               styleClass="helper-label"/>

                    </VBox>

                </VBox>

                <!-- Bodyfat Fat Calculator Inputs -->
                <VBox fx:id="bodyFatInputFields"
                      maxWidth="Infinity"
                      visible="false"
                      managed="false">

                    <!-- Neck -->
                    <VBox styleClass="field-group">
                        <Label styleClass="field-label"
                               text="Neck (cm)"/>

                        <TextField fx:id="neckField"
                                   promptText="Enter your nect circumference"
                                   styleClass="input-field,text-field"/>

                        <Label fx:id="neckMessage"
                               styleClass="helper-label"
                               wrapText="true"
                               minHeight="-Infinity"
                               maxHeight="Infinity"
                               maxWidth="Infinity"/>
                    </VBox>

                    <!-- Waist -->
                    <VBox styleClass="field-group">
                        <Label styleClass="field-label"
                               text="Waist (cm)"/>

                        <TextField fx:id="waistField"
                                   promptText="Enter your waist circumference"
                                   styleClass="input-field,text-field"/>

                        <Label fx:id="waistMessage"
                               styleClass="helper-label"
                               wrapText="true"
                               minHeight="-Infinity"
                               maxHeight="Infinity"
                               maxWidth="Infinity"/>
                    </VBox>

                    <!-- Hip -->
                    <VBox fx:id="hipGroup"
                          styleClass="field-group"
                          visible="false"
                          managed="false">

                        <Label styleClass="field-label"
                               text="Hip (cm)"/>

                        <TextField fx:id="hipField"
                                   promptText="Enter your hip circumference"
                                   styleClass="input-field,text-field"/>

                        <Label fx:id="hipMessage"
                               styleClass="helper-label"
                               wrapText="true"
                               minHeight="-Infinity"
                               maxHeight="Infinity"
                               maxWidth="Infinity"/>
                    </VBox>

                </VBox>

                <!-- Calculate -->
                <Button maxWidth="Infinity"
                        onAction="#handleCalculate"
                        styleClass="action-btn"
                        text="Calculate"/>

            </VBox>

        </VBox>

        <!-- Result panel -->
        <VBox fx:id="resultPanel"
              maxWidth="Infinity"
              maxHeight="-Infinity"
              visible="false"
              styleClass="result-panel">

            <!-- BMI -->
            <VBox fx:id="bmiResultView"
                  maxWidth="Infinity"
                  visible="false"
                  managed="false"
                  styleClass="calculator-result-view">

                <!-- Result -->
                <VBox maxWidth="Infinity"
                      alignment="TOP_CENTER">

                    <!-- Title -->
                    <Label text="BMI Result"
                           maxWidth="Infinity"
                           styleClass="result-title"/>

                    <!-- Main -->
                    <HBox alignment="CENTER"
                          styleClass="result-main-row">

                        <Label fx:id="bmiValueLabel"
                               text="-"
                               styleClass="result-main-value"/>

                        <Label text="kg/m²"
                               styleClass="result-main-unit"/>

                    </HBox>

                    <!-- Status -->
                    <Label fx:id="bmiStatusLabel"
                           visible="false"
                           managed="false"
                           styleClass="result-category-badge"/>

                    <!-- Details -->
                    <VBox maxWidth="Infinity"
                          styleClass="result-details">

                        <!-- Healthy BMI range -->
                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row">

                            <Label text="Healthy BMI range"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label text="18.5 – 24.9"
                                   styleClass="result-detail-value"/>

                        </HBox>

                        <!-- Healthy Weight range -->
                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row">

                            <Label text="Healthy weight range"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="healthyWeightRangeLabel"
                                   text="—"
                                   styleClass="result-detail-value"/>

                        </HBox>

                        <!-- BMI Prime -->
                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row">

                            <HBox alignment="CENTER_LEFT"
                                  spacing="6">

                                <Label text="BMI Prime"
                                       styleClass="result-detail-label"/>

                                <Button text="?"
                                        focusTraversable="false"
                                        styleClass="info-button">

                                    <tooltip>
                                        <Tooltip fx:id="bmiPrimeTooltip"
                                                 text="Your BMI divided by 25. A value of 1.00 corresponds to the upper limit of the normal BMI range."
                                                 wrapText="true"
                                                 maxWidth="280"/>
                                    </tooltip>

                                </Button>

                            </HBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="bmiPrimeLabel"
                                   text="—"
                                   styleClass="result-detail-value"/>

                        </HBox>

                        <!-- Ponderal index -->
                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row">

                            <HBox alignment="CENTER_LEFT"
                                  spacing="6">

                                <Label text="Ponderal Index"
                                       styleClass="result-detail-label"/>

                                <Button text="?"
                                        focusTraversable="false"
                                        styleClass="info-button">

                                    <tooltip>
                                        <Tooltip fx:id="bmiPonderalIndexTooltip"
                                                 text="A height-adjusted measure of body mass calculated by dividing weight by height cubed."
                                                 wrapText="true"
                                                 maxWidth="280"/>
                                    </tooltip>

                                </Button>

                            </HBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="ponderalIndexLabel"
                                   text="—"
                                   styleClass="result-detail-value"/>
                        </HBox>

                    </VBox>
                </VBox>

                <!-- Categories -->
                <VBox maxWidth="Infinity">

                    <!-- Title -->
                    <Label text="BMI Categories"
                           maxWidth="Infinity"
                           styleClass="bmi-categories-title"/>

                    <VBox maxWidth="Infinity"
                          styleClass="result-details">

                        <!-- Underweight -->
                        <HBox fx:id="underweightCategoryRow"
                              alignment="CENTER_LEFT"
                              styleClass="result-detail-row, bmi-category-underweight">

                            <Label text="Underweight"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="underweightBmiCategoryLabel"
                                   styleClass="result-detail-value"/>

                        </HBox>

                        <!-- Normal -->
                        <HBox fx:id="normalCategoryRow"
                              alignment="CENTER_LEFT"
                              styleClass="result-detail-row, bmi-category-normal">

                            <Label text="Normal"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="normalBmiCategoryLabel"
                                   styleClass="result-detail-value"/>

                        </HBox>

                        <!-- Overweight -->
                        <HBox fx:id="overweightCategoryRow"
                              alignment="CENTER_LEFT"
                              styleClass="result-detail-row, bmi-category-overweight">

                            <Label text="Overweight"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="overweightBmiCategoryLabel"
                                   styleClass="result-detail-value"/>

                        </HBox>

                        <!-- Obese -->
                        <HBox fx:id="obeseCategoryRow"
                              alignment="CENTER_LEFT"
                              styleClass="result-detail-row, bmi-category-obese">

                            <Label text="Obese"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="obeseBmiCategoryLabel"
                                   styleClass="result-detail-value"/>

                        </HBox>

                    </VBox>

                </VBox>

            </VBox>

            <!-- TDEE & BMR -->
            <VBox fx:id="tdeeResultView"
                  maxWidth="Infinity"
                  visible="false"
                  managed="false"
                  styleClass="calculator-result-view">

                <!-- Main Result -->
                <VBox maxWidth="Infinity"
                      alignment="TOP_CENTER">

                    <!-- Title -->
                    <Label fx:id="tdeeTitleLabel"
                           text="TDEE Result"
                           maxWidth="Infinity"
                           styleClass="result-title"/>

                    <Label fx:id="bmrTitleLabel"
                           text="BMR Result"
                           maxWidth="Infinity"
                           visible="false"
                           managed="false"
                           styleClass="result-title"/>

                    <!-- Main -->
                    <HBox alignment="CENTER"
                          styleClass="result-main-row">

                        <!-- TDEE Title -->
                        <Label fx:id="tdeeValueLabel"
                               text="-"
                               styleClass="result-main-value"/>

                        <!-- BMR Title -->
                        <Label text="kcal/day"
                               styleClass="result-main-unit"/>

                    </HBox>

                    <!-- Details -->
                    <VBox maxWidth="Infinity"
                          styleClass="result-details">

                        <!-- TDEE Details -->
                        <Label fx:id="tdeeDetailsLabel"
                               text="Estimated daily calories needed to maintain your current weight at the selected activity level."
                               maxWidth="Infinity"
                               wrapText="true"
                               styleClass="result-description"/>

                        <!-- BMR Details -->
                        <Label fx:id="bmrDetailsLabel"
                               text="Your BMR is the estimated number of calories your body needs each day to maintain essential functions while at complete rest."
                               maxWidth="Infinity"
                               wrapText="true"
                               visible="false"
                               managed="false"
                               styleClass="result-description"/>

                    </VBox>

                </VBox>

                <!-- Calculation summary -->
                <VBox fx:id="calculationSummaryGroup"
                      maxWidth="Infinity">

                    <Label text="Calculation Summary"
                           maxWidth="Infinity"
                           styleClass="bmi-categories-title"/>

                    <VBox maxWidth="Infinity"
                          styleClass="result-details">

                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row">

                            <Label text="Activity level"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="tdeeActivityLevelLabel"
                                   text="—"
                                   styleClass="result-detail-value"/>

                        </HBox>

                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row">

                            <Label text="Estimated BMR"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="tdeeBmrValueLabel"
                                   text="—"
                                   styleClass="result-detail-value"/>

                        </HBox>

                    </VBox>

                </VBox>

                <!-- Daily goals -->
                <VBox fx:id="calorieTargetsGroup"
                      maxWidth="Infinity">

                    <Label text="Daily Calorie Goals"
                           maxWidth="Infinity"
                           styleClass="bmi-categories-title"/>

                    <VBox maxWidth="Infinity"
                          styleClass="result-details">

                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row, calorie-goal-loss">

                            <Label text="Weight loss"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="weightLossCaloriesLabel"
                                   text="—"
                                   styleClass="result-detail-value"/>

                        </HBox>

                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row, calorie-goal-maintain">

                            <Label text="Maintain weight"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="maintenanceCaloriesLabel"
                                   text="—"
                                   styleClass="result-detail-value"/>

                        </HBox>

                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row, calorie-goal-gain">

                            <Label text="Weight gain"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="weightGainCaloriesLabel"
                                   text="—"
                                   styleClass="result-detail-value"/>

                        </HBox>

                    </VBox>

                </VBox>

            </VBox>

            <!-- Body Fat -->
            <VBox fx:id="bodyFatResultView"
                  maxWidth="Infinity"
                  visible="false"
                  managed="false"
                  styleClass="calculator-result-view">

                <!-- Result -->
                <VBox maxWidth="Infinity"
                      alignment="TOP_CENTER">

                    <!-- Title -->
                    <Label text="Body Fat Result"
                           maxWidth="Infinity"
                           styleClass="result-title"/>

                    <!-- Main -->
                    <HBox alignment="CENTER"
                          styleClass="result-main-row">

                        <Label fx:id="bodyFatValueLabel"
                               text="-"
                               styleClass="result-main-value"/>

                        <Label text="\%"
                               styleClass="result-main-unit"/>

                    </HBox>

                    <!-- Category -->
                    <HBox alignment="CENTER">
                        <Label fx:id="bodyFatCategoryLabel"
                               styleClass="result-category-badge"/>
                    </HBox>

                    <!-- Details -->
                    <VBox maxWidth="Infinity"
                          styleClass="result-details">

                        <!-- Body Fat Mass -->
                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row">

                            <Label text="Body Fat Mass"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="bodyFatMassLabel"
                                   text="—"
                                   styleClass="result-detail-value"/>
                        </HBox>

                        <!-- Lean Body Mass -->
                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row">

                            <Label text="Lean Body Mass"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="leanBodyMassLabel"
                                   text="—"
                                   styleClass="result-detail-value"/>
                        </HBox>

                        <!-- Ideal Body Fat -->
                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row">

                            <Label text="Ideal Body Fat"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="idealBodyFatLabel"
                                   text="—"
                                   styleClass="result-detail-value"/>
                        </HBox>

                        <!-- Body Fat to Reach Ideal -->
                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row">

                            <Label fx:id="weightChangeTitleLabel"
                                   text="Weight to"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="weightChangeLabel"
                                   text="—"
                                   styleClass="result-detail-value"/>
                        </HBox>

                    </VBox>

                </VBox>

                <!-- Categories -->
                <VBox maxWidth="Infinity">

                    <!-- Title -->
                    <Label text="Body Fat Categories"
                           maxWidth="Infinity"
                           styleClass="bmi-categories-title"/>

                    <VBox maxWidth="Infinity"
                          styleClass="result-details">

                        <!-- Essential fat -->
                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row, body-fat-category-essential">

                            <Label text="Essential fat"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="essentialBodyFatLabel"
                                   styleClass="result-detail-value"/>

                        </HBox>

                        <!-- Athletes -->
                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row, body-fat-category-athletes">

                            <Label text="Athletes"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="athletesBodyFatLabel"
                                   styleClass="result-detail-value"/>

                        </HBox>

                        <!-- Fitness -->
                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row, body-fat-category-fitness">

                            <Label text="Fitness"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="fitnessBodyFatLabel"
                                   styleClass="result-detail-value"/>

                        </HBox>

                        <!-- Average -->
                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row, body-fat-category-average">

                            <Label text="Average"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="averageBodyFatLabel"
                                   styleClass="result-detail-value"/>

                        </HBox>

                        <!-- Obese -->
                        <HBox alignment="CENTER_LEFT"
                              styleClass="result-detail-row, body-fat-category-obese">

                            <Label text="Obese"
                                   styleClass="result-detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="obeseBodyFatLabel"
                                   styleClass="result-detail-value"/>

                        </HBox>

                    </VBox>

                </VBox>

            </VBox>

        </VBox>
    </fx:define>

    <top>
        <HBox maxWidth="Infinity"
              styleClass="calculator-tabs">

            <ToggleButton fx:id="bmiTab"
                          text="BMI"
                          toggleGroup="$calculatorGroup"
                          styleClass="calculator-tab-button"
                          selected="true"/>

            <ToggleButton fx:id="tdeeTab"
                          text="TDEE"
                          toggleGroup="$calculatorGroup"
                          styleClass="calculator-tab-button"/>

            <ToggleButton fx:id="bodyFatTab"
                          text="Body Fat"
                          toggleGroup="$calculatorGroup"
                          styleClass="calculator-tab-button"/>
        </HBox>
    </top>

    <center>

        <!-- If the window is too small, scroll will be added -->
        <ScrollPane fx:id="setupScroll"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="app-scroll">

            <StackPane fx:id="calculatorBodyStack"
                       maxWidth="Infinity">

                <HBox fx:id="wideContainer"
                      maxWidth="Infinity"
                      styleClass="calculator-body-row"/>

                <VBox fx:id="narrowContainer"
                      maxWidth="Infinity"
                      visible="false"
                      managed="false"
                      styleClass="calculator-body-col"/>

            </StackPane>

        </ScrollPane>
    </center>

</BorderPane>