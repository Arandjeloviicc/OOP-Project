<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ScrollPane?>
<StackPane
        fx:id="rootLayout"
        styleClass="auth-root"
        stylesheets="@../../css/auth/register-view.css"
        xmlns="http://javafx.com/javafx/22"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.fittrack.controller.auth.RegisterController">

    <!-- Background image layer -->
    <ImageView fx:id="backgroundImage"
               styleClass="bg-image"
               StackPane.alignment="CENTER" />

    <!-- Dark overlay to deepen the bg -->
    <Pane maxHeight="Infinity"
          maxWidth="Infinity"
          styleClass="bg-overlay"
          StackPane.alignment="CENTER" />

    <ScrollPane fitToWidth="true"
                fitToHeight="true"
                hbarPolicy="NEVER"
                styleClass="app-scroll">

        <StackPane styleClass="app-scroll-content">

            <StackPane styleClass="content-layer">

                <!-- Glass card -->
                <VBox alignment="TOP_CENTER"
                      maxHeight="-Infinity"
                      styleClass="glass-card"
                      StackPane.alignment="CENTER">

                    <VBox alignment="TOP_CENTER" styleClass="card-inner">

                        <!-- Title -->
                        <Label styleClass="title-label"
                               wrapText="true"
                               maxWidth="Infinity"
                               textAlignment="CENTER"
                               text="Start your journey" />

                        <!-- Subtitle -->
                        <Label maxWidth="Infinity"
                               styleClass="subtitle-label"
                               text="Create your account to track workouts, nutrition and weight."
                               textAlignment="CENTER"
                               wrapText="true"/>

                        <!-- Fields container -->
                        <VBox styleClass="fields-wrap">

                            <!-- Username -->
                            <VBox styleClass="field-group">
                                <Label styleClass="field-label"
                                       text="Username" />

                                <TextField fx:id="usernameField"
                                           maxWidth="Infinity"
                                           promptText="Enter your username"
                                           styleClass="input-field,text-field" />

                                <Label fx:id="usernameMessage"
                                       styleClass="helper-label"
                                       wrapText="true"
                                       maxWidth="Infinity"
                                       text="3–20 characters; start with a letter."/>
                            </VBox>

                            <!-- Email -->
                            <VBox styleClass="field-group">
                                <Label styleClass="field-label"
                                       text="Email"/>

                                <TextField fx:id="emailField"
                                           maxWidth="Infinity"
                                           promptText="Enter your email"
                                           styleClass="input-field,text-field"/>

                                <Label fx:id="emailMessage"
                                       styleClass="helper-label"
                                       wrapText="true"
                                       maxWidth="Infinity"
                                       text="Use a valid address, e.g. name@example.com."/>
                            </VBox>

                            <!-- Password -->
                            <VBox styleClass="field-group">
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="field-label"
                                           text="Password"
                                           HBox.hgrow="ALWAYS" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <HBox alignment="CENTER_RIGHT" onMouseClicked="#togglePassword" spacing="5" styleClass="pw-toggle-wrap">
                                        <Label fx:id="toggleIcon" styleClass="pw-toggle-icon" text="◉" />
                                        <Label fx:id="toggleLabel" styleClass="pw-toggle-text" text="Show" />
                                    </HBox>
                                </HBox>

                                <StackPane>
                                    <PasswordField fx:id="passwordField"
                                                   maxWidth="Infinity"
                                                   promptText="Enter your password"
                                                   styleClass="input-field,text-field" />
                                    <TextField fx:id="passwordVisible"
                                               maxWidth="Infinity"
                                               managed="false"
                                               promptText="Enter your password"
                                               styleClass="input-field,text-field"
                                               visible="false" />
                                </StackPane>

                                <Label fx:id="passwordMessage"
                                       styleClass="helper-label"
                                       wrapText="true"
                                       maxWidth="Infinity"
                                       text="At least 8 characters"/>
                            </VBox>

                        </VBox>

                        <!-- Register button -->
                        <Button fx:id="registerButton"
                                maxWidth="Infinity"
                                onAction="#handleRegister"
                                styleClass="action-btn"
                                text="Create account" />

                        <!-- Login row -->
                        <HBox alignment="CENTER" spacing="4" styleClass="bottom-row">
                            <Label styleClass="bottom-text" text="Already have an account?" />
                            <Hyperlink onAction="#handleLogin" styleClass="bottom-link" text="Log in here" />
                        </HBox>

                    </VBox>
                </VBox>

            </StackPane>

        </StackPane>

    </ScrollPane>

</StackPane>
